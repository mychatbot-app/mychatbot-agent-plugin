{
  "mcpServers": {
    "mychatbot-sales": {
      "type": "http",
      "url": "https://api.mychatbot.app/api/mcp/sales-management",
      "headers": {
        "Authorization": "Bearer ${user_config.account_access_key}"
      }
    },
    "mychatbot-agents": {
      "type": "http",
      "url": "https://api.mychatbot.app/api/mcp/agents",
      "headers": {
        "Authorization": "Bearer ${user_config.account_access_key}"
      }
    },
    "mychatbot-ugc": {
      "type": "http",
      "url": "https://api.mychatbot.app/api/mcp/ugc",
      "headers": {
        "Authorization": "Bearer ${user_config.account_access_key}"
      }
    },
    "mychatbot-docs": {
      "type": "http",
      "url": "https://api.mychatbot.app/api/mcp/docs"
    }
  }
}
